# macOS
.DS_Store

# Obsidian (keep config, ignore personal data)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/*.bak
.obsidian/plugins/*/data.json

# Node.js
node_modules/

# Temporary
*.tmp
*.bak

# Raw materials: local-first, not tracked by default
# Users can explicitly track selected raw files with git add -f
/raw/**/*.md
!/raw/sortspec.md
!/raw/**/sortspec.md

# Graph exports are derived artifacts (rebuild with `llm-wiki graph`)
/graph/
